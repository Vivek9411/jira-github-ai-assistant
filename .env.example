# Application Configuration
APP_NAME="Jira-GitHub AI Assistant"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Security & Encryption (Fernet AES-256 key for third-party tokens)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY="dGhpc19pc19hXzMyX2J5dGVfZHVtbXlfa2V5X2Zvcl9kZXYxMjM="

# JWT Settings
JWT_SECRET_KEY="supersecretjwtkeyforlocaldevelopmentpurposesonlychangeinproduction"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (Asyncpg for PostgreSQL)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/jira_gh_db"

# Email / OTP Settings
EMAIL_DELIVERY_METHOD="console" # Options: console, smtp
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@jiraghassistant.local"
OTP_EXPIRE_MINUTES=10

# GitHub Integration Defaults
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Jira Integration Defaults
JIRA_CLIENT_ID=""
JIRA_CLIENT_SECRET=""

# LLM Provider Configuration
LLM_PROVIDER="gemini" # Options: gemini, openai, mock
GEMINI_API_KEY=""
OPENAI_API_KEY=""
